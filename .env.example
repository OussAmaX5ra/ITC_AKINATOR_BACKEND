# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=C3E8A1F6D9B42705E3C8A1F6D9B42705C3E8A1F6D9B42705E3C8A1F6D9B42705

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=4A9E2C7D1F6B8305A4E9C2D7F1B68305A4E9C2D7F1B68305A4E9C2D7F1B68305
# JWT access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
# JWT refresh token lifetime in days
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: anthropic | openai | gemini | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_KEY=your-api-key-here

# Ollama (local) — only used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# ── Speech-to-Text (faster-whisper) ──────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3
STT_MODEL=small
# Device: cpu | cuda
STT_DEVICE=cpu

# ── Text-to-Speech (Piper) ────────────────────────────────────────────────────
TTS_ENABLED=true

# ── Game Engine Tuning ────────────────────────────────────────────────────────
MAX_QUESTIONS=20
GUESS_CONFIDENCE=0.85
MAX_GUESSES=3
ANSWER_TIMEOUT_S=30

# ── Vision / Presence Detection ───────────────────────────────────────────────
# Seconds face must be present before player_arrived is emitted
PRESENCE_ARRIVE_S=1.0
# Seconds face must be absent before player_left is emitted
PRESENCE_LEAVE_S=5.0

# ── Device Heartbeat ─────────────────────────────────────────────────────────
# Redis TTL for device heartbeat key (seconds)
DEVICE_HB_TTL_S=15

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
