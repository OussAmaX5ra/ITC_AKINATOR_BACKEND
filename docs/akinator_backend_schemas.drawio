hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="t_usr"><mxGeometry x="0" y="134" width="300" height="26" as="geometry"/></mxCell><mxCell id="p2-72" value="&lt;span style=&quot;display:inline-block;width:26px;color:#b85450&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;is_active&lt;/b&gt; &lt;span style=&quot;color:#777777&quot;&gt;bool&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="t_usr"><mxGeometry x="0" y="160" width="300" height="26" as="geometry"/></mxCell><mxCell id="p2-73" value="&lt;span style=&quot;display:inline-block;width:26px;color:#b85450&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;span style=&quot;color:#777777&quot;&gt;timestamptz&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="t_usr"><mxGeometry x="0" y="186" width="300" height="26" as="geometry"/></mxCell><mxCell id="p2-74" value="&lt;span style=&quot;display:inline-block;width:26px;color:#b85450&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;last_login_at&lt;/b&gt; &lt;span style=&quot;color:#777777&quot;&gt;timestamptz&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="t_usr"><mxGeometry x="0" y="212" width="300" height="26" as="geometry"/></mxCell><mxCell id="p2-75" value="&lt;b&gt;Redis keys (live state, with TTL)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;session:{id}&lt;/font&gt;&lt;br&gt;JSON: state, category, language, history[], candidates{entity_id: score}, excluded[], question_no, guesses_made, last_activity. TTL 2 h&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;device:{id}:hb&lt;/font&gt;&lt;br&gt;heartbeat timestamp, TTL 15 s (expired = offline)&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;device:{id}:presence&lt;/font&gt;&lt;br&gt;faces, active bbox, since&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;admin:live&lt;/font&gt;&lt;br&gt;pub/sub channel for the admin live view&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;rl:{ip}:{route}&lt;/font&gt;&lt;br&gt;rate-limit counters&lt;br&gt;&lt;br&gt;&lt;i&gt;Finished sessions are flushed to PostgreSQL, then the key is deleted.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fce5cd;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="340" height="380" as="geometry"/></mxCell><mxCell id="p2-76" value="&lt;b&gt;Indexes &amp;amp; constraints&lt;/b&gt;&lt;br&gt;&lt;br&gt;• UNIQUE (turns.session_id, turns.turn_no)&lt;br&gt;• INDEX sessions (started_at), (device_id), (status)&lt;br&gt;• INDEX entities (category, is_approved)&lt;br&gt;• GIN INDEX entities.attributes&lt;br&gt;• INDEX devices (last_heartbeat)&lt;br&gt;• Privacy: NO image / audio columns anywhere (spec: nothing stored by default)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="710" width="360" height="190" as="geometry"/></mxCell><mxCell id="p2-77" value="device_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_dev" target="t_ses"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-78" value="session_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_ses" target="t_turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-79" value="session_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_ses" target="t_gue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-80" value="session_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERzeroToOne;" edge="1" parent="1" source="t_ses" target="t_tea"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-81" value="entity_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_ent" target="t_gue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-82" value="entity_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_ent" target="t_tea"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-83" value="reviewed_by" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_usr" target="t_tea"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-84" value="prompt_version_id" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t_pv" target="t_ses"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Game engine workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-2" value="&lt;b style='font-size:20px'&gt;Game engine workflow — one full game (greeting → 5-20 questions → guess → learn)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="p3-3" value="&lt;span style='color:#666666;font-size:11px'&gt;Blue = process · Orange = DB / Redis write · Purple = model call (LLM / STT) · Yellow = decision · Green = start / end&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1600" height="22" as="geometry"/></mxCell><mxCell id="p3-4" value="&lt;b&gt;Engine parameters (env)&lt;/b&gt;&lt;br&gt;&lt;br&gt;MAX_QUESTIONS = 20&lt;br&gt;GUESS_CONFIDENCE = 0.85&lt;br&gt;MAX_GUESSES = 3&lt;br&gt;TOP_K_CANDIDATES = 10&lt;br&gt;LLM_RETRIES = 1&lt;br&gt;ANSWER_TIMEOUT_S = 30&lt;br&gt;TURN_LATENCY_TARGET ≤ 2 s&lt;br&gt;&lt;br&gt;&lt;i&gt;Send &quot;thinking&quot; to the client as soon as the answer arrives, to hide the LLM latency.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="290" height="250" as="geometry"/></mxCell><mxCell id="p3-5" value="&lt;b&gt;KB scoring (per answer)&lt;/b&gt;&lt;br&gt;&lt;br&gt;yes +1.0 · probably +0.5 · dont_know 0&lt;br&gt;probably_not −0.5 · no −1.0&lt;br&gt;&lt;br&gt;score(e) += weight × match(e.attributes[attr])&lt;br&gt;Top-K candidates go in the prompt; wrong guesses are excluded." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="290" height="190" as="geometry"/></mxCell><mxCell id="p3-6" value="&lt;b&gt;Abandon rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;face absent &amp;gt; 5 s, WS closed &amp;gt; 60 s, or 2 answer timeouts → sessions.status = abandoned, Redis key deleted." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="290" height="130" as="geometry"/></mxCell><mxCell id="p3-7" value="&lt;b&gt;Start session&lt;/b&gt;&lt;br&gt;WS start / POST /api/games&lt;br&gt;category · language · source" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="60" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-8" value="&lt;b&gt;Create session&lt;/b&gt;&lt;br&gt;INSERT sessions (status = active)&lt;br&gt;init Redis: history = [], excluded = [], n = 0, guesses_made = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="260" height="80" as="geometry"/></mxCell><mxCell id="p3-9" value="&lt;b&gt;Load candidates from KB&lt;/b&gt;&lt;br&gt;entities WHERE category = ? AND is_approved&lt;br&gt;score(e) = 1.0 for all" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="260" width="260" height="70" as="geometry"/></mxCell><mxCell id="p3-10" value="&lt;b&gt;Turn n: build context&lt;/b&gt;&lt;br&gt;Q&amp;amp;A history · top-K candidates&lt;br&gt;excluded[] · question number n" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="360" width="260" height="70" as="geometry"/></mxCell><mxCell id="p3-11" value="&lt;b&gt;Call LLM&lt;/b&gt; (provider from config)&lt;br&gt;system prompt (versioned, language)&lt;br&gt;+ context → strict JSON {action, question, guess, confidence}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="460" width="260" height="80" as="geometry"/></mxCell><mxCell id="p3-12" value="Valid JSON&lt;br&gt;(schema check)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="570" width="260" height="90" as="geometry"/></mxCell><mxCell id="p3-13" value="" style="ellipse;html=1;fillColor=#666666;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="514" y="690" width="12" height="12" as="geometry"/></mxCell><mxCell id="p3-14" value="confidence ≥ 0.85&lt;br&gt;or n = 20?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="730" width="260" height="110" as="geometry"/></mxCell><mxCell id="p3-15" value="Retry already&lt;br&gt;used?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="570" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3-16" value="&lt;b&gt;Fallback: KB-only mode&lt;/b&gt;&lt;br&gt;best splitting attribute → question&lt;br&gt;or top candidate → guess" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="580" width="230" height="70" as="geometry"/></mxCell><mxCell id="p3-17" value="&lt;b&gt;ASK: send question&lt;/b&gt;&lt;br&gt;WS question {text, n/20, lang}&lt;br&gt;+ Piper TTS audio on the robot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="880" width="260" height="70" as="geometry"/></mxCell><mxCell id="p3-18" value="&lt;b&gt;Wait for answer&lt;/b&gt; (30 s timeout)&lt;br&gt;voice audio · button · touch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="980" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-19" value="&lt;b&gt;If voice: Whisper STT&lt;/b&gt; (lang)&lt;br&gt;keyword map → 1 of 5 answers&lt;br&gt;(yes · no · dont_know · probably · probably_not)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="1070" width="260" height="70" as="geometry"/></mxCell><mxCell id="p3-20" value="Answer&lt;br&gt;understood?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="1170" width="260" height="100" as="geometry"/></mxCell><mxCell id="p3-21" value="Ask to repeat&lt;br&gt;or press a button" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="1190" width="190" height="60" as="geometry"/></mxCell><mxCell id="p3-22" value="&lt;b&gt;Store turn&lt;/b&gt;: INSERT turns&lt;br&gt;append history in Redis&lt;br&gt;update candidate scores · n = n + 1&lt;br&gt;(emit &quot;thinking&quot; + admin live event)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="1310" width="260" height="90" as="geometry"/></mxCell><mxCell id="p3-23" value="&lt;b&gt;GUESS: send guess&lt;/b&gt;&lt;br&gt;WS guess {name, image?, confidence}&lt;br&gt;INSERT guesses (guess_no = guesses_made + 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="740" width="280" height="90" as="geometry"/></mxCell><mxCell id="p3-24" value="Player says&lt;br&gt;&quot;Right&quot;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="860" width="280" height="100" as="geometry"/></mxCell><mxCell id="p3-25" value="&lt;b&gt;WIN&lt;/b&gt;&lt;br&gt;sessions.result = win&lt;br&gt;guesses.is_correct = true&lt;br&gt;entities.times_correct += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="870" width="260" height="80" as="geometry"/></mxCell><mxCell id="p3-26" value="&lt;b&gt;Wrong&lt;/b&gt;&lt;br&gt;guesses.is_correct = false · guesses_made += 1&lt;br&gt;add entity to excluded[]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="1000" width="280" height="70" as="geometry"/></mxCell><mxCell id="p3-27" value="guesses_made&lt;br&gt;&amp;lt; 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="1100" width="280" height="100" as="geometry"/></mxCell><mxCell id="p3-28" value="&lt;b&gt;&quot;Teach me&quot;&lt;/b&gt;&lt;br&gt;player types the right answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="1240" width="280" height="60" as="geometry"/></mxCell><mxCell id="p3-29" value="&lt;b&gt;Learn (B6)&lt;/b&gt;&lt;br&gt;INSERT teach_submissions (Q&amp;amp;A trail)&lt;br&gt;upsert entity (is_approved = false)&lt;br&gt;sessions.result = lose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="1330" width="280" height="90" as="geometry"/></mxCell><mxCell id="p3-30" value="&lt;b&gt;Finalize&lt;/b&gt;: UPDATE sessions (ended_at, question_count, status = finished) · delete Redis key&lt;br&gt;push WS result · publish stats event to admin · client back to idle after 10 s without a face" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="1480" width="480" height="80" as="geometry"/></mxCell><mxCell id="p3-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-7" target="p3-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-8" target="p3-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-9" target="p3-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;