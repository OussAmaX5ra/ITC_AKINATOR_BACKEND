ell id="p4-29" value="audio" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="815" as="sourcePoint"/><mxPoint x="350" y="815" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-30" value="question {text, n, max} + audio" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="855" as="sourcePoint"/><mxPoint x="110" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-31" value="audio chunk (push-to-talk)  |  button press" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="905" as="sourcePoint"/><mxPoint x="350" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-32" value="transcribe(audio, lang)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="945" as="sourcePoint"/><mxPoint x="830" y="945" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-33" value="text → 1 of 5 answers" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="985" as="sourcePoint"/><mxPoint x="350" y="985" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-34" value="event: thinking" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1025" as="sourcePoint"/><mxPoint x="110" y="1025" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-35" value="submit_answer(session_id, answer)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1065" as="sourcePoint"/><mxPoint x="1070" y="1065" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-36" value="INSERT turns · update history &amp;amp; scores" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1105" as="sourcePoint"/><mxPoint x="1550" y="1105" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-37" value="guess {name, confidence}  (≥ 0.85 or n = 20)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1200" as="sourcePoint"/><mxPoint x="350" y="1200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-38" value="guess {name, image?}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1240" as="sourcePoint"/><mxPoint x="110" y="1240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-39" value="verdict {correct: true | false}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1280" as="sourcePoint"/><mxPoint x="350" y="1280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-40" value="submit_verdict(session_id, correct)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1320" as="sourcePoint"/><mxPoint x="1070" y="1320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-41" value="INSERT guesses · UPDATE entities · UPDATE sessions" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1360" as="sourcePoint"/><mxPoint x="1550" y="1360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-42" value="result: win | keep asking | teach" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1400" as="sourcePoint"/><mxPoint x="350" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-43" value="result {outcome}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1440" as="sourcePoint"/><mxPoint x="110" y="1440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-44" value="teach {correct_name}  (after 3rd wrong guess)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1480" as="sourcePoint"/><mxPoint x="350" y="1480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-45" value="save_teach(name, qa_trail)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1520" as="sourcePoint"/><mxPoint x="1070" y="1520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-46" value="INSERT teach_submissions + entity (pending)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1560" as="sourcePoint"/><mxPoint x="1550" y="1560" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 · Session states"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-2" value="&lt;b style='font-size:20px'&gt;Session state machine (Redis session:{id}.state ↔ sessions.status in PostgreSQL)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="p5-3" value="&lt;span style='color:#666666;font-size:11px'&gt;Same flow for robot and web. States live in Redis; only active / finished / abandoned reach the DB.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1600" height="22" as="geometry"/></mxCell><mxCell id="p5-4" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;attract screen loop&lt;br&gt;&lt;i&gt;no session&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-5" value="&lt;b&gt;WELCOME&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;greet · pick language &amp;amp; category&lt;br&gt;&lt;i&gt;session created (active)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-6" value="&lt;b&gt;ASKING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;question sent · listening&lt;br&gt;&lt;i&gt;waits ≤ 30 s for answer&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-7" value="&lt;b&gt;PROCESSING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;STT → map answer → LLM&lt;br&gt;&lt;i&gt;&quot;thinking&quot; animation&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-8" value="&lt;b&gt;GUESSING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;Are you thinking of…?&quot;&lt;br&gt;&lt;i&gt;waits for Right / Wrong&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-9" value="&lt;b&gt;TEACHING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;player types the right answer&lt;br&gt;&lt;i&gt;after the 3rd wrong guess&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-10" value="&lt;b&gt;FINISHED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;win / lose animation&lt;br&gt;&lt;i&gt;sessions.status = finished&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="220" height="90" as="geometry"/></mxCell><mxCell id="p5-11" value="&lt;b&gt;ABANDONED&lt;/b&gt; (sessions.status = abandoned)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;From any active state (WELCOME · ASKING · PROCESSING · GUESSING · TEACHING) when:&lt;br&gt;• face absent &amp;gt; 5 s · • WS closed &amp;gt; 60 s · • no answer after 2 timeouts&lt;br&gt;• admin stops the robot&lt;br&gt;Effect: Redis key deleted, partial turns kept for stats.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="820" width="560" height="120" as="geometry"/></mxCell><mxCell id="p5-12" value="&lt;b&gt;Where each state is stored&lt;/b&gt;&lt;br&gt;&lt;br&gt;Redis: idle · welcome · asking · processing · guessing · teaching · finished · abandoned&lt;br&gt;PostgreSQL: active (WELCOME → TEACHING) · finished · abandoned&lt;br&gt;Every transition publishes an event on the Redis channel &lt;font face=&quot;Courier New&quot;&gt;admin:live&lt;/font&gt; for the admin live view." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="820" width="640" height="120" as="geometry"/></mxCell><mxCell id="p5-13" value="face &amp;gt; 1 s&lt;br&gt;(player_arrived)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-4" target="p5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-14" value="start {category, language}&lt;br&gt;→ engine returns 1st question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-5" target="p5-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-15" value="answer received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-6" target="p5-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-16" value="next question ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-7" target="p5-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-17" value="conf ≥ 0.85 or n = 20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-7" target="p5-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-18" value="wrong &amp;amp; guesses &amp;lt; 3&lt;br&gt;→ keep asking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-8" target="p5-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="545"/><mxPoint x="750" y="545"/></Array></mxGeometry></mxCell><mxCell id="p5-19" value="Right → win" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-8" target="p5-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-20" value="wrong (3rd)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-8" target="p5-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-21" value="teach saved → lose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-9" target="p5-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-22" value="10 s without a face" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-10" target="p5-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="100"/><mxPoint x="150" y="100"/></Array></mxGeometry></mxCell><mxCell id="p5-23" value="any active state:&lt;br&gt;timeout / disconnect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p5-5" target="p5-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-24" value="reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-11" target="p5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6 · API &amp; WebSocket contract"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-2" value="&lt;b style='font-size:20px'&gt;API contract — REST endpoints and WebSocket messages&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="p6-3" value="&lt;span style='color:#666666;font-size:11px'&gt;REST = config, stats, admin and a mirror of the game actions (web fallback / testing). WebSocket = real-time game, frames and audio.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1600" height="22" as="geometry"/></mxCell><mxCell id="p6-4" value="&lt;table style='border-collapse:collapse;font-size:11px;width:100%' cellpadding='3' cellspacing='0'&gt;&lt;tr style='background:#dae8fc'&gt;&lt;th align='left' width='60'&gt;Method&lt;/th&gt;&lt;th align='left' width='290'&gt;Endpoint&lt;/th&gt;&lt;th align='left' width='70'&gt;Auth&lt;/th&gt;&lt;th align='left' width='340'&gt;Description&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='4'&gt;&lt;b&gt;Public / game (player token returned by POST /api/games)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/health&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;none&lt;/td&gt;&lt;td valign='top'&gt;liveness + DB / Redis check&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/config&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;none&lt;/td&gt;&lt;td valign='top'&gt;languages, categories, max_questions&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/games&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;none&lt;/td&gt;&lt;td valign='top'&gt;create session {category, language, source}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/games/&amp;lt;id&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;session&lt;/td&gt;&lt;td valign='top'&gt;state + history&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/games/&amp;lt;id&amp;gt;/answer&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;session&lt;/td&gt;&lt;td valign='top'&gt;{answer} (mirror of WS)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/games/&amp;lt;id&amp;gt;/verdict&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;session&lt;/td&gt;&lt;td valign='top'&gt;{correct: bool}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/games/&amp;lt;id&amp;gt;/teach&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;session&lt;/td&gt;&lt;td valign='top'&gt;{name}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;DELETE&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/games/&amp;lt;id&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;session&lt;/td&gt;&lt;td valign='top'&gt;abandon&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='4'&gt;&lt;b&gt;Auth&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/auth/login&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;none&lt;/td&gt;&lt;td valign='top'&gt;{username, password} → JWT access + refresh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/auth/refresh&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;refresh&lt;/td&gt;&lt;td valign='top'&gt;new access token&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/auth/me&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;JWT&lt;/td&gt;&lt;td valign='top'&gt;current user + role&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='4'&gt;&lt;b&gt;Admin (JWT + role)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/stats&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;robots online, games today, win rate, avg questions&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/sessions&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;filters: status, source, date; paginated&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/sessions/&amp;lt;id&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;turns + guesses&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;CRUD&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/entities[/&amp;lt;id&amp;gt;]&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;KB editor (fix wrong guesses)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/teach&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;pending teach submissions&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/teach/&amp;lt;id&amp;gt;/approve|reject&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;merge into entities&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET/POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/devices&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;list / register (token shown once)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/devices/&amp;lt;id&amp;gt;/command&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;operator&lt;/td&gt;&lt;td valign='top'&gt;{start | stop | reboot}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;GET/POST&lt;/td&gt;&lt;td valign='top'&gt;&lt;font face='Courier New'&gt;/api/admin/prompts&lt;/font&gt;&lt;/td&gt;&lt;td valign='top'&gt;admin&lt;/td&gt;&lt;td valign='top'&gt;list / activate prompt version&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#6c8ebf;spacing=6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="800" height="840" as="geometry"/></mxCell><mxCell id="p6-5" value="&lt;table style='border-collapse:collapse;font-size:11px;width:100%' cellpadding='3' cellspacing='0'&gt;&lt;tr style='background:#dae8fc'&gt;&lt;th align='left' width='40'&gt;Dir&lt;/th&gt;&lt;th align='left' width='230'&gt;Message&lt;/th&gt;&lt;th align='left' width='540'&gt;Payload&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Envelope: &lt;font face='Courier New'&gt;{&quot;v&quot;:1, &quot;type&quot;:&quot;question&quot;, &quot;session_id&quot;:&quot;…&quot;, &quot;seq&quot;:12, &quot;data&quot;:{…}}&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='3'&gt;&lt;b&gt;/ws/robot (device token) — one connection per robot&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;→&lt;/td&gt;&lt;td valign='top'&gt;hello&lt;/td&gt;&lt;td valign='top'&gt;{device_id, fw, camera_ok, mic_ok}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;→&lt;/td&gt;&lt;td valign='top'&gt;binary 0x01&lt;/td&gt;&lt;td valign='top'&gt;JPEG frame (1-byte type header)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;→&lt;/td&gt;&lt;td valign='top'&gt;binary 0x02 / audio_end&lt;/td&gt;&lt;td valign='top'&gt;PCM16 16 kHz mono chunks / end of utterance&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;→&lt;/td&gt;&lt;td valign='top'&gt;heartbeat&lt;/td&gt;&lt;td valign='top'&gt;{ts} every 5 s&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;→&lt;/td&gt;&lt;td valign='top'&gt;start · button · verdict · teach&lt;/td&gt;&lt;td valign='top'&gt;{category, language} · {answer} · {correct} · {name}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;config / ack&lt;/td&gt;&lt;td valign='top'&gt;language list, limits&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;event&lt;/td&gt;&lt;td valign='top'&gt;player_arrived · player_left · face_boxes&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;session_started&lt;/td&gt;&lt;td valign='top'&gt;{session_id}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;listening · thinking&lt;/td&gt;&lt;td valign='top'&gt;UI + LED states&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;question&lt;/td&gt;&lt;td valign='top'&gt;{text, n, max, lang}  (+ binary 0x03 TTS audio)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;guess&lt;/td&gt;&lt;td valign='top'&gt;{name, image?, confidence}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;result&lt;/td&gt;&lt;td valign='top'&gt;{outcome: win | lose, ask_teach}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;command · error&lt;/td&gt;&lt;td valign='top'&gt;{start | stop} · {code, message}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='3'&gt;&lt;b&gt;/ws/player (session token) — same game messages, frames / audio optional (webcam, mic)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#eeeeee'&gt;&lt;td colspan='3'&gt;&lt;b&gt;/ws/admin (JWT)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;→&lt;/td&gt;&lt;td valign='top'&gt;subscribe&lt;/td&gt;&lt;td valign='top'&gt;{device_id | session_id}&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;robot_status · session_update&lt;/td&gt;&lt;td valign='top'&gt;online / camera / mic · state changes&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #dddddd'&gt;&lt;td valign='top'&gt;←&lt;/td&gt;&lt;td valign='top'&gt;turn · frame_preview · stats_tick&lt;/td&gt;&lt;td valign='top'&gt;live Q&amp;amp;A · JPEG + face boxes · counters&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#82b366;spacing=6;overflow=fill;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="830" height="640" as="geometry"/></mxCell><mxCell id="p6-6" value="&lt;b&gt;Conventions&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Errors (REST): 400 validation · 401 / 403 auth · 404 · 409 session already finished · 429 rate limit · 503 LLM down (engine switches to KB-only mode, still answers 200).&lt;br&gt;• WS close codes: 4001 unauthorized · 4008 rate limit · 4010 replaced by a new connection.&lt;br&gt;• Every client message carries &lt;font face=&quot;Courier New&quot;&gt;seq&lt;/font&gt;; the server ignores duplicates after a reconnect (robot auto-reconnect ≤ 10 s).&lt;br&gt;• Versioned API: &lt;font face=&quot;Courier New&quot;&gt;/api/v1/…&lt;/font&gt; is optional but cheap if you add it now." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="730" width="830" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7 · Project structure &amp; build order"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-2" value="&lt;b style='font-size:20px'&gt;Flask project structure, build order and configuration&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="p7-3" value="akinator-backend/&lt;br&gt;├─ wsgi.py                    # gunicorn entry point&lt;br&gt;├─ Dockerfile · docker-compose.yml (api, postgres, redis, nginx)&lt;br&gt;├─ .env.example · requirements.txt&lt;br&gt;├─ app/&lt;br&gt;│  ├─ __init__.py             # create_app() factory&lt;br&gt;│  ├─ config.py               # Dev / Prod / Test settings from env&lt;br&gt;│  ├─ extensions.py           # db, migrate, redis, jwt, sock, cors, limiter&lt;br&gt;│  ├─ api/                    # REST blueprints&lt;br&gt;│  │  ├─ auth.py · games.py · admin.py&lt;br&gt;│  │  ├─ devices.py · entities.py · health.py&lt;br&gt;│  │  └─ schemas.py           # Pydantic request / response models&lt;br&gt;│  ├─ ws/                     # flask-sock routes&lt;br&gt;│  │  ├─ robot.py · player.py · admin.py&lt;br&gt;│  │  └─ protocol.py          # envelope, message types, binary headers&lt;br&gt;│  ├─ services/&lt;br&gt;│  │  ├─ vision/   detector.py · presence.py&lt;br&gt;│  │  ├─ speech/   stt.py · tts.py · answer_mapper.py&lt;br&gt;│  │  ├─ game/&lt;br&gt;│  │  │  ├─ engine.py         # orchestrates one turn&lt;br&gt;│  │  │  ├─ session_store.py  # Redis state&lt;br&gt;│  │  │  ├─ candidates.py     # KB scoring&lt;br&gt;│  │  │  ├─ prompts.py        # loads versioned prompts&lt;br&gt;│  │  │  ├─ llm_client.py     # provider adapters&lt;br&gt;│  │  │  ├─ validator.py      # JSON schema + retry&lt;br&gt;│  │  │  ├─ fallback.py       # KB-only mode&lt;br&gt;│  │  │  └─ learner.py        # teach → entity&lt;br&gt;│  │  └─ devices.py           # heartbeat, status, commands&lt;br&gt;│  ├─ models/                 # SQLAlchemy models (1 file per table)&lt;br&gt;│  ├─ repositories/           # DB queries, no business logic&lt;br&gt;│  └─ utils/                  # security.py · logging.py · ws_helpers.py&lt;br&gt;├─ prompts/v1/                # system_en.txt · system_fr.txt · system_ar.txt&lt;br&gt;├─ data/seed_entities.json    # starting knowledge base&lt;br&gt;├─ migrations/                # Alembic&lt;br&gt;├─ scripts/                   # seed_kb.py · create_admin.py&lt;br&gt;└─ tests/                     # unit (engine, mapper) · API · WS · latency" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fillColor=#f8f8f8;strokeColor=#999999;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="760" height="880" as="geometry"/></mxCell><mxCell id="p7-4" value="&lt;b&gt;1 · Skeleton (weeks 1-2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;App factory, Docker Compose, config, /api/health, pytest + CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-5" value="&lt;b&gt;2 · Data layer (weeks 2-3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Models, migrations, seed script for the KB (≥ 200 entities)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="172" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-4" target="p7-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-7" value="&lt;b&gt;3 · Engine, KB-only (weeks 3-4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Candidate scoring, Redis session store, REST game endpoints: playable with curl / Postman&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="284" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-5" target="p7-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-9" value="&lt;b&gt;4 · LLM integration (weeks 4-5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Provider adapters, prompts v1 (EN/FR/AR), JSON validation + retry, fallback, guess rules, teach&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="396" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-7" target="p7-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-11" value="&lt;b&gt;5 · WebSocket gateway (weeks 5-6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;flask-sock routes, protocol, device auth, heartbeat, reconnect + seq handling; web player uses it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="508" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-9" target="p7-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-13" value="&lt;b&gt;6 · Vision + speech (weeks 5-7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Face detection + presence events, Whisper STT + answer mapper, Piper TTS (S)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="620" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-11" target="p7-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-15" value="&lt;b&gt;7 · Admin API + live view (weeks 6-8)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JWT + roles, stats, sessions, entity editor, teach review, Redis pub/sub&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="732" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-13" target="p7-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-17" value="&lt;b&gt;8 · Hardening (weeks 8-11)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Latency ≤ 2 s per turn, 4 h soak test, privacy check (no images / audio stored), 30 test games&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="844" width="440" height="86" as="geometry"/></mxCell><mxCell id="p7-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-15" target="p7-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-19" value="&lt;b&gt;.env.example&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;FLASK_ENV=development&lt;br&gt;SECRET_KEY=…&lt;br&gt;JWT_SECRET=…&lt;br&gt;DATABASE_URL=postgresql+psycopg://…&lt;br&gt;REDIS_URL=redis://redis:6379/0&lt;br&gt;&lt;br&gt;LLM_PROVIDER=anthropic|openai|gemini|ollama&lt;br&gt;LLM_MODEL=…&lt;br&gt;LLM_API_KEY=…&lt;br&gt;OLLAMA_URL=http://host:11434&lt;br&gt;&lt;br&gt;STT_MODEL=small&lt;br&gt;STT_DEVICE=cuda|cpu&lt;br&gt;TTS_ENABLED=true&lt;br&gt;&lt;br&gt;MAX_QUESTIONS=20&lt;br&gt;GUESS_CONFIDENCE=0.85&lt;br&gt;MAX_GUESSES=3&lt;br&gt;ANSWER_TIMEOUT_S=30&lt;br&gt;PRESENCE_ARRIVE_S=1&lt;br&gt;PRESENCE_LEAVE_S=5&lt;br&gt;DEVICE_HB_TTL_S=15&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="60" width="380" height="560" as="geometry"/></mxCell><mxCell id="p7-20" value="&lt;b&gt;Rules of thumb&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Blueprints and WS handlers stay thin: parse → call service → format reply.&lt;br&gt;• All game logic lives in &lt;font face=&quot;Courier New&quot;&gt;services/game&lt;/font&gt;, so REST and WS share exactly the same code (requirement B8).&lt;br&gt;• Repositories hold queries, services hold rules.&lt;br&gt;• Prompts are files under version control + a row in prompt_versions.&lt;br&gt;• Swapping the LLM provider = env var only." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="640" width="380" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>