<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0"><diagram id="p1" name="1 · Backend architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-2" value="&lt;b style='font-size:20px'&gt;Akinator Robot — Backend architecture (Flask)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="p1-3" value="&lt;span style='color:#666666;font-size:11px'&gt;Purple = clients · Blue = API layer · Green = services · Yellow = game engine · Orange = data · Red dashed = external provider&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1600" height="22" as="geometry"/></mxCell><mxCell id="p1-4" value="&lt;b&gt;Robot (ESP32-S3)&lt;/b&gt;&lt;br&gt;JPEG frames · mic audio · buttons&lt;br&gt;WSS /ws/robot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="240" height="90" as="geometry"/></mxCell><mxCell id="p1-5" value="&lt;b&gt;Player web app (React)&lt;/b&gt;&lt;br&gt;REST + WSS /ws/player" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="240" height="90" as="geometry"/></mxCell><mxCell id="p1-6" value="&lt;b&gt;Admin panel (React)&lt;/b&gt;&lt;br&gt;REST + WSS /ws/admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="240" height="90" as="geometry"/></mxCell><mxCell id="p1-7" value="&lt;b&gt;Nginx reverse proxy&lt;/b&gt;&lt;br&gt;&lt;br&gt;TLS termination&lt;br&gt;HTTPS / WSS&lt;br&gt;serves the React build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="150" height="350" as="geometry"/></mxCell><mxCell id="p1-8" value="Docker · backend container (Flask 3 + Gunicorn gevent/gthread)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="860" height="760" as="geometry"/></mxCell><mxCell id="p1-9" value="API layer (Flask blueprints + WebSocket routes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="820" height="200" as="geometry"/></mxCell><mxCell id="p1-10" value="&lt;b&gt;REST blueprints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/api/auth · /api/games&lt;br&gt;/api/admin · /api/devices&lt;br&gt;/api/entities · /api/health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1-11" value="&lt;b&gt;WebSocket routes (flask-sock)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/ws/robot · /ws/player · /ws/admin&lt;br&gt;protocol.py: JSON envelope +&lt;br&gt;binary frames (JPEG / PCM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="160" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1-12" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JWT (admin) · device token (robot)&lt;br&gt;CORS · rate limit · request log&lt;br&gt;Pydantic validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="160" width="240" height="140" as="geometry"/></mxCell><mxCell id="p1-13" value="Service layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="350" width="820" height="290" as="geometry"/></mxCell><mxCell id="p1-14" value="&lt;b&gt;Vision service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;OpenCV + MediaPipe&lt;br&gt;largest face = player&lt;br&gt;arrived &amp;gt; 1 s · left &amp;gt; 5 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="190" height="130" as="geometry"/></mxCell><mxCell id="p1-15" value="&lt;b&gt;Speech service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;faster-whisper (STT)&lt;br&gt;answer mapper AR / FR / EN&lt;br&gt;Piper TTS (S)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="390" width="190" height="130" as="geometry"/></mxCell><mxCell id="p1-16" value="&lt;b&gt;Device &amp;amp; presence manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;heartbeats · robot status · remote start / stop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="400" height="80" as="geometry"/></mxCell><mxCell id="p1-17" value="&lt;b&gt;Game engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• session_store (Redis state)&lt;br&gt;• candidates (KB scoring)&lt;br&gt;• prompts (versioned, AR/FR/EN)&lt;br&gt;• llm_client (provider = config)&lt;br&gt;• validator (JSON schema, retry ×1)&lt;br&gt;• fallback (KB-only mode)&lt;br&gt;• learner (teach → entity)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="960" y="390" width="360" height="230" as="geometry"/></mxCell><mxCell id="p1-18" value="Data access layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="670" width="820" height="150" as="geometry"/></mxCell><mxCell id="p1-19" value="&lt;b&gt;SQLAlchemy models + repositories&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Flask-Migrate (Alembic) for schema changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="710" width="380" height="90" as="geometry"/></mxCell><mxCell id="p1-20" value="&lt;b&gt;Redis client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;live session state · heartbeats · pub/sub to admin live view&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="710" width="380" height="90" as="geometry"/></mxCell><mxCell id="p1-21" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;sessions · turns · entities …" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="890" width="380" height="90" as="geometry"/></mxCell><mxCell id="p1-22" value="&lt;b&gt;Redis 7&lt;/b&gt;&lt;br&gt;session:{id} · device:{id}:hb …" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="890" width="380" height="90" as="geometry"/></mxCell><mxCell id="p1-23" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cloud API (Claude / GPT / Gemini)&lt;br&gt;or Ollama (Llama 3.1 8B / Qwen 2.5 7B)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1440" y="450" width="230" height="110" as="geometry"/></mxCell><mxCell id="p1-24" value="&lt;b&gt;Flask-specific choices&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;flask-sock&lt;/b&gt; for plain WebSocket: the ESP32 (arduinoWebSockets) talks raw WS. Flask-SocketIO would force a Socket.IO client on the robot.&lt;br&gt;&lt;br&gt;• Gunicorn with gevent (or gthread) workers; &lt;b&gt;all shared state in Redis&lt;/b&gt;, never in process memory, so several workers are safe.&lt;br&gt;&lt;br&gt;• Never block a WS handler with STT / vision / LLM: use a thread pool (or an RQ / Celery worker for GPU jobs).&lt;br&gt;&lt;br&gt;• App factory + blueprints, config from .env files, Flask-Migrate for DB changes.&lt;br&gt;&lt;br&gt;• Pydantic validates REST bodies, WS messages and the LLM JSON output.&lt;br&gt;&lt;br&gt;• Provider chosen by env var: LLM_PROVIDER = anthropic | openai | gemini | ollama." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="440" height="400" as="geometry"/></mxCell><mxCell id="p1-25" value="WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-4" target="p1-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-26" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-5" target="p1-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-27" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-6" target="p1-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-28" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-7" target="p1-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-29" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-9" target="p1-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-30" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-13" target="p1-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-31" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-19" target="p1-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-32" value="RESP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-20" target="p1-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-33" value="JSON (strict)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p1-17" target="p1-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · Database schema"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-2" value="&lt;b style='font-size:20px'&gt;Database schema — PostgreSQL (SQLAlchemy models) + Redis live state&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="p2-3" value="&lt;span style='color:#666666;font-size:11px'&gt;PK = primary key · FK = foreign key · enums can be native PG enums or CHECK constraints&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1600" height="22" as="geometry"/></mxCell><mxCell id="t_dev" value="devices" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="300" height="264" as="geometry"/></mxCell><mxCell id="p2-4" value="&lt;span style=&quot;display:inline-block;width:26px;color:#b85450&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/span&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style=&quot;color:#777777&quot;&gt;uuid&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="t_dev"><mxGeometry x="0" y="30" width="300" height="26" as="geometry"/></mxCell><mxCell id="p2-5" value="&lt;span style=&quot;display:inline-block;width:26px;color:#b85450&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;name&lt;/b&gt; &lt;span style=&quot;color:#777777&quot;&gt;varchar&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="t_dev"><mxGeometry x="0" y="56" width="300" height="26" as="geometry"/></mxCell><mxCell id="p2-6" value="&lt;span style=&quot;display:inline-block;width:26px;color:#b85450&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;token_hash&lt;/b&gt; &lt;span style=&quot;c