arget="p3-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-55" value="Yes → keep asking (guess forced again if n ≥ 20)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-27" target="p3-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="1150"/><mxPoint x="1590" y="395"/></Array></mxGeometry></mxCell><mxCell id="p3-56" value="No (3rd guess wrong)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-27" target="p3-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-28" target="p3-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.125;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-29" target="p3-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exi