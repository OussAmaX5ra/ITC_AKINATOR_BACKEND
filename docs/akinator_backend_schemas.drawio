etry x="20" y="600" width="1700" height="26" as="geometry"/></mxCell><mxCell id="p4-7" value="&lt;b&gt;4 · Guess, verdict and learning&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1145" width="1700" height="26" as="geometry"/></mxCell><mxCell id="p4-8" value="Robot / Web client" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-9" value="Flask gateway&lt;br&gt;(REST + WS)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="265" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-10" value="Vision service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-11" value="Speech service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="745" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-12" value="Game engine" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-13" value="LLM provider" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1225" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-14" value="Redis / PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1465" y="80" width="170" height="1580" as="geometry"/></mxCell><mxCell id="p4-15" value="loop [until guess]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#d79b00;dashed=1;width=140;height=24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="635" width="1680" height="500" as="geometry"/></mxCell><mxCell id="p4-16" value="binary JPEG frame (10 fps) · /ws/robot" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint"/><mxPoint x="350" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-17" value="detect_faces(frame)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="235" as="sourcePoint"/><mxPoint x="590" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-18" value="boxes[], largest face, presence state" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="275" as="sourcePoint"/><mxPoint x="350" y="275" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-19" value="event: player_arrived (face &amp;gt; 1 s)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="315" as="sourcePoint"/><mxPoint x="110" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-20" value="start {category, language}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="405" as="sourcePoint"/><mxPoint x="350" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-21" value="start_session(category, lang, source, device)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="445" as="sourcePoint"/><mxPoint x="1070" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-22" value="INSERT sessions · SET session:{id} · load KB candidates" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="485" as="sourcePoint"/><mxPoint x="1550" y="485" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-23" value="session_id" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor